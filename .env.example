# ============================================================
# SuaraKebadongan — Environment Variables
# Salin ke .env.local dan isi dengan nilai sebenarnya.
# JANGAN commit .env.local ke git (sudah ada di .gitignore).
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY_HERE

# ── Gerbang Passcode ─────────────────────────────────────────
# PASSCODE: kata sandi yang diketik anggota KKN di gerbang.
# GATE_SECRET: random string untuk HMAC-SHA256 cookie.
# Generate GATE_SECRET: openssl rand -hex 32

GATE_PASSCODE=your_passcode_here
GATE_SECRET=your_random_secret_hex_here
